# FastAPI ML service environment variables
# AI provider: Groq (replaces Anthropic Claude)
GROQ_API_KEY=gsk_your-groq-api-key
# Optional: override the default Groq model
GROQ_MODEL=llama-3.3-70b-versatile

# Model artifact paths (relative to fastapi_ml/ or absolute)
MODEL_PATH=ml/model.pkl
PREPROCESSOR_PATH=ml/preprocessor.pkl
